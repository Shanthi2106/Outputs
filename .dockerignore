# Used when building backend image: docker build -f backend/Dockerfile .
# Reduces context size and keeps secrets out of the image.

.git
.gitignore
*.md
docs
frontend
api
*.bat
*.sh
.env
.env.*
!.env.example
**/node_modules
**/.DS_Store
**/dist
backend/my_chroma_data
**/*.log
**/.vercelignore
**/vercel.json
**/pnpm-lock.yaml
