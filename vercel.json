{
  "version": 2,
  "buildCommand": "bash build-vercel.sh",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo 'Dependencies installed during build'",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x"
    }
  }
}
