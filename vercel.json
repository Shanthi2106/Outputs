{
  "version": 2,
  "buildCommand": "(cd frontend && NODE_ENV=development npm install && npm run build) || exit 1",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo 'Dependencies installed during build'",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
