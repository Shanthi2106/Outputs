# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# AI Provider Configuration
# Choose: 'openai' or 'anthropic'
AI_PROVIDER=openai
AI_MODEL=gpt-4-turbo-preview

# OpenAI Configuration (if AI_PROVIDER=openai)
OPENAI_API_KEY=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

# Anthropic Configuration (if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration
DATABASE_URL=postgresql://neondb_owner:npg_VSDC1vZXAlB4@ep-divine-king-ahwi65s4-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379

# Vector Database Configuration
# 
# PostgreSQL with pgvector is used for storing document chunks (RAG for uploaded documents)
# Pinecone is used for storing term embeddings (semantic term search)
# 
# PostgreSQL vector storage uses the same DATABASE_URL as your main database
# Ensure your PostgreSQL database has the pgvector extension installed
# - For Neon/Supabase: pgvector is pre-installed
# - For local PostgreSQL: Install from https://github.com/pgvector/pgvector
# - For other providers: Check if pgvector is available in your plan

# Pinecone Configuration (for term storage)
# Get your API key from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=autism-terms

# Embedding Configuration
# Model options: text-embedding-3-small (1536 dims), text-embedding-3-large (3072 dims)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Document Chunking Configuration
# CHUNK_SIZE: Characters per chunk (default: 1000)
# CHUNK_OVERLAP: Overlap between chunks in characters (default: 200)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Security Configuration
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
