{
  "name": "autism-assistant-backend",
  "version": "1.0.0",
  "description": "Backend API for AI-Powered Parent Assistant for Autism",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODEJS_HELPERS=0 tsx watch src/index.ts",
    "build": "cross-env NODEJS_HELPERS=0 tsc && node copy-knowledge-base.js",
    "start": "cross-env NODEJS_HELPERS=0 node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "populate-vectors": "cross-env NODEJS_HELPERS=0 tsx scripts/populate-vectors.ts",
    "setup-vector-db": "cross-env NODEJS_HELPERS=0 tsx scripts/setup-vector-db.ts",
    "verify-rag": "cross-env NODEJS_HELPERS=0 tsx scripts/verify-rag.ts"
  },
  "keywords": [
    "autism",
    "assistant",
    "ai",
    "healthcare",
    "education"
  ],
  "author": "Sai Prashanthi Vemula",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@pinecone-database/pinecone": "^6.1.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "mammoth": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.24.1",
    "pdf-parse": "^1.1.4",
    "pg": "^8.11.3",
    "redis": "^4.6.11",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.10.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": "20.x"
  }
}
